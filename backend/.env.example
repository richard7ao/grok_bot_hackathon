# OPENAI_API_KEY lives in the repo-root .env (bun dev / bun run smoke load ../.env, then this file).
OPENAI_MODEL=gpt-5.4-mini
REVIEW_MODE=openai     # openai | fake (fake: passes if transcript has a 5+ letter word from a product fact)
OPENAI_URL=https://api.openai.com/v1/chat/completions
PORT=3000
DB_PATH=dropquest.db
UPLOADS_DIR=uploads
VENUE_LAT=51.5237      # set to the real venue pin on the day
VENUE_LNG=-0.0785
HOLD_MS=600000
PURCHASE_MS=300000
