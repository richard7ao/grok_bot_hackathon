{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "routes": [
    { "src": "/", "dest": "/landing.html" },
    { "src": "/mobile", "dest": "/index.html" },
    { "src": "/desktop", "dest": "/studio.html" },
    { "src": "/api/(.*)", "dest": "https://dropquest.onrender.com/api/$1" },
    { "src": "/uploads/(.*)", "dest": "https://dropquest.onrender.com/uploads/$1" }
  ]
}
